MODEL_PATH=models/model.pkl
# Токен для /upload-model (заголовок X-Upload-Token); пусто — загрузка открыта, только для разработки
MODEL_UPLOAD_TOKEN=
METRICS_PATH=reports/metrics.json
AUTOLOAD_MODEL=true
RISK_THRESHOLD=0.5
MAX_UPLOAD_MB=50
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5432/clinic
RISK_MEDIUM_THRESHOLD=0.4
RISK_HIGH_THRESHOLD=0.7
CLINIC_TIMEZONE=Europe/Moscow
CLINIC_OPEN_HOUR=8
CLINIC_CLOSE_HOUR=20
MIN_CANCEL_HOURS=2
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
